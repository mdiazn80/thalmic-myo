{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thalmic Myo by mdiazn80",
  "version": "0.1.0",
  "identifier": "com.mdiazn80.thalmic-myo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thalmic Myo by mdiazn80",
        "width": 1280,
        "height": 760,
        "resizable": true,
        "minWidth": 1100,
        "minHeight": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
